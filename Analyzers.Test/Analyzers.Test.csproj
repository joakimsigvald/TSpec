<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>TSpec.Analyzers.Test</AssemblyName>
		<RootNamespace>TSpec.Analyzers.Test</RootNamespace>
		<OutputType>Exe</OutputType>
		<UseAppHost>true</UseAppHost>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<!-- xunit.analyzers 2.1.0 is built against Roslyn 4.11, so hosting it needs at least that -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<PackageReference Include="xunit.analyzers" Version="2.1.0" GeneratePathProperty="true" />
		<None Include="$(Pkgxunit_analyzers)\analyzers\dotnet\cs\xunit.analyzers.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<Using Include="TSpec.Assert" />
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\Analyzers\Analyzers.csproj" />
	</ItemGroup>

</Project>
