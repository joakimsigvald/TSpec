# EditorConfig — https://editorconfig.org
root = true

[*.cs]

##############################################################################
# 1. const is PascalCase — at every accessibility.
#
#     public   const int MinPrecedence = 1;
#     internal const string FileName = "SPECIFICATION.md";
#     private  const int MaxElements = 5;
#
# A const is a compile-time constant, not mutable state, and reads as part of
# the type's vocabulary rather than as one of its fields. It therefore does
# *not* take the underscore prefix that rule 2 applies to real fields.
#
# 2. Every other non-public field is _camelCase.
#
#     private readonly StringBuilder _sb = new();
#     private static readonly char[] _breakAfterCues = ...;
#     protected readonly TParent _parent = parent;
#
# Rule order matters: the first matching rule wins, so the const rule must
# stay above the field rule or const would be swept into it.
#
# Public members are PascalCase. The fluent binding words — .and, .but, .or —
# are deliberate lowercase exceptions carrying [SuppressMessage(.., "IDE1006")].
##############################################################################

# --- 1. const --------------------------------------------------------------
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

# --- 2. other non-public fields --------------------------------------------
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_symbols.non_public_fields.applicable_kinds = field
dotnet_naming_symbols.non_public_fields.applicable_accessibilities = private, internal, protected, protected_internal, private_protected

dotnet_naming_rule.non_public_fields_are_underscore_camel_case.symbols = non_public_fields
dotnet_naming_rule.non_public_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.non_public_fields_are_underscore_camel_case.severity = warning

# The rule severities above do nothing on their own — the analyzer that reports
# naming violations must also be switched on, or these rules are documentation
# the build ignores. Paired with <EnforceCodeStyleInBuild> in the csproj, a
# violation becomes a build error under TreatWarningsAsErrors.
dotnet_diagnostic.IDE1006.severity = warning

##############################################################################
# These rules apply to spec projects too, including Core.Test. Note what that
# means there: TSpec renders source identifiers into the specification text
# tests pin with Specification.Is(...), so a field or const name in a spec
# project is part of the generated documentation. Renaming is therefore never
# purely cosmetic — it rewrites specifications and can shift their
# 80-character wrapping. Choose names that read well in the rendered output.
##############################################################################
