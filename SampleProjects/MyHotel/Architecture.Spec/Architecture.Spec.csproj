<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>MyHotel.Architecture.Spec</AssemblyName>
		<RootNamespace>MyHotel.Architecture.Spec</RootNamespace>
		<OutputType>Exe</OutputType>
		<UseAppHost>true</UseAppHost>
		<IsPackable>false</IsPackable>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Castle.Core" Version="5.2.1" />
		<PackageReference Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

	<!-- TSpec's working copy and TSpec.Architecture.CSharp's, built into ..\lib. A reference by path brings no
	     dependencies, so the package's Roslyn is referenced here. -->
	<ItemGroup>
		<Reference Include="TSpec" HintPath="..\lib\TSpec.dll" />
		<Reference Include="TSpec.Architecture.CSharp" HintPath="..\lib\TSpec.Architecture.CSharp.dll" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<Analyzer Include="..\lib\TSpec.Analyzers.dll" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\**\*.csproj" Exclude="..\Architecture.Spec\**" />
	</ItemGroup>

</Project>
