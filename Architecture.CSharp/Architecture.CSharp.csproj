<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Architecture rules on the code of a TSpec build: each project's source files and the types they declare</Description>
		<Authors>Joakim Sigvald</Authors>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>TSpec.Architecture.CSharp</AssemblyName>
		<RootNamespace>TSpec.Architecture.CSharp</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageTags>architecture test specification xunit tspec</PackageTags>
		<PackageProjectUrl>https://github.com/joakimsigvald/TSpec</PackageProjectUrl>
		<RepositoryUrl>https://github.com/joakimsigvald/TSpec.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageVersion>1.3.0</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>
			NEW
			* Nodes&lt;T&gt;(): a project's or a file's syntax nodes of one kind, each named by its file and line
			* SourceSpan.Lines: the lines a span covers
			* A member's Gives and Takes: the types its return type and its parameters' types name, or whether one is of a kind, is a type or meets a condition
			* A file's DependsOn: the projects and packages whose types its code uses, as the rules name them
			* A file's Model: the compiler's view of its syntax
			* AllTypes on a project or a file: its types with those nested in them
			* A member's IsOriginal: whether it sets its own name and signature, neither implementing nor overriding
			* A file's Folder, Name and Extension
			CHANGED
			* Requires TSpec 5.4.0 or later
			OBSOLETE
			* OpensInternalsTo: TSpec's own SourceProject.OpensInternalsTo takes its place, read without Roslyn
		</PackageReleaseNotes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<!-- TEMPORARY: the local feed holding TSpec 5.4.0-local.3. -->
		<RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)bin\LocalFeed</RestoreAdditionalProjectSources>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<!-- TEMPORARY: TSpec 5.4.0's OpensInternalsTo and Build.TryFindPackage from a local build until it is released. -->
		<PackageReference Include="TSpec" Version="5.4.0-local.3" PrivateAssets="none" />
		<InternalsVisibleTo Include="TSpec.Architecture.CSharp.Test" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
