<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>A fluent Given-When-Then specification framework for xUnit. Write behavior definitions as unit tests with built-in auto-mocking and data generation</Description>
		<VersionPrefix></VersionPrefix>
		<Authors>Joakim Sigvald</Authors>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>TSpec</AssemblyName>
		<RootNamespace>TSpec</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageTags>unit test specification given when then fluent mock xunit automock</PackageTags>
		<PackageProjectUrl>https://github.com/joakimsigvald/TSpec</PackageProjectUrl>
		<RepositoryUrl>https://github.com/joakimsigvald/TSpec.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageVersion>3.3.0</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>
			BREAKING - a passing test can turn red on upgrade
			* Each mention of a mocked type is a mock of its own, and the subject's dependencies are others: hand one over with Using(The&lt;IRule&gt;) to arrange or verify what the subject holds
			* Two dependencies of one type are two mocks; Given&lt;IRule&gt;() and Then&lt;IRule&gt;() reach them all
			ADDED
			* Set up one mock of several: Given(TheSecond&lt;IRule&gt;).That(…), Given(tag).That(…), And(TheSecond&lt;IRule&gt;)
			* Verify one mock of several: Then(TheSecond&lt;IRule&gt;, _ =&gt; _.Passes(), Once), by name, by wasInvoked or by tag; a failure says when other mocks of the type were called
			* AndReturnsDefault after a setup on one mock is refused: a default is set up for every mock of the type
			CHANGED
			* A mock reads as its type, IRule, until a mention names it: the second IRule
			* A default after a call setup reads "and otherwise returns 5"
			FIXED
			* A failure message relating to mock verification adds information that differentiates between mock instances of the same type ("the IChild" or "IChild from IParent.GetChild(1)" instead of just "IChild")
			* AndReturnsDefault states its value in the specification instead of "value"
		</PackageReleaseNotes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Castle.Core" Version="5.2.1" />
		<PackageReference Include="xunit.v3.extensibility.core" Version="4.0.1" />
		<PackageReference Include="xunit.v3.assert" Version="4.0.1" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\TSpec-agent-reference.md" Pack="true" PackagePath="\" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
