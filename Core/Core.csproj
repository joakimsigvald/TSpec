<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>A fluent Given-When-Then specification framework for xUnit. Write behavior definitions as unit tests with built-in auto-mocking and data generation</Description>
		<VersionPrefix></VersionPrefix>
		<Authors>Joakim Sigvald</Authors>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>TSpec</AssemblyName>
		<RootNamespace>TSpec</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageTags>unit test specification given when then fluent mock xunit automock</PackageTags>
		<PackageProjectUrl>https://github.com/joakimsigvald/TSpec</PackageProjectUrl>
		<RepositoryUrl>https://github.com/joakimsigvald/TSpec.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageVersion>4.3.0</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>
			NEW
			* Are for collections: items.Are(expected) asserts the same items in any order, and nothing more
			* Source.Projects for custom architecture rules: each project's dependencies and source files, with their lines and the types they declare
			IMPROVED
			* A failure counts the items of a collection, Empty() included
			* A failed Are, Like or EquivalentTo on a collection names the missing and the extra items
			FIXED
			* EquivalentTo and Like passed when the actual held more than expected; now they fail
			* Like and EquivalentTo never returned on an endless sequence compared with a collection
			OBSOLETE
			* Project.Dependencies: Source.Projects takes its place, and graph["X"] is Source.Projects["X"].Dependencies
			BREAKING - a passing test can turn red on upgrade
			* Like and EquivalentTo fail at setup when neither side is a collection, since either may never end
		</PackageReleaseNotes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Castle.Core" Version="5.2.1" />
		<PackageReference Include="xunit.v3.extensibility.core" Version="4.0.1" />
		<PackageReference Include="xunit.v3.assert" Version="4.0.1" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\TSpec-agent-reference.md" Pack="true" PackagePath="\" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Analyzers\Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\Analyzers\bin\$(Configuration)\netstandard2.0\TSpec.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>
