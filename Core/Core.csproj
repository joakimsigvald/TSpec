<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>A fluent Given-When-Then specification framework for xUnit. Write behavior definitions as unit tests with built-in auto-mocking and data generation</Description>
		<VersionPrefix></VersionPrefix>
		<Authors>Joakim Sigvald</Authors>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>TSpec</AssemblyName>
		<RootNamespace>TSpec</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageTags>unit test specification given when then fluent mock xunit automock</PackageTags>
		<PackageProjectUrl>https://github.com/joakimsigvald/TSpec</PackageProjectUrl>
		<RepositoryUrl>https://github.com/joakimsigvald/TSpec.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageVersion>3.2.0</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>
			BREAKING - a passing test can turn red on upgrade
			* A call answering with a mock gives a child per address, so The&lt;IChild&gt;() is no longer what the subject received from it: a verification naming the child names the call that reached it, Then&lt;ISink&gt;(_ =&gt; _.Accept(The&lt;IParent&gt;().GetChild(1)))
			* Verifying through a step that answered with a real instance is refused, naming the setup to write, where it counted no calls whatever the subject did - a verification that passed with Never now fails
			CHANGED
			* A mocked property keeps its value: a read answers the last set, else what the first read answered
			* Setting a mock's property in a setup lambda is allowed - GuardClause for setters removed
			* A call no setup matches is answered once per address: the same arguments answer the same from then on, other arguments answer otherwise
			FIXED
			* A call answering with a mock gives one per address, so verifying Then&lt;IParent&gt;(_ =&gt; _.GetChild(1).Get(9), Once) no longer counts what was called through GetChild(2)
		</PackageReleaseNotes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Castle.Core" Version="5.2.1" />
		<PackageReference Include="xunit.v3.extensibility.core" Version="4.0.1" />
		<PackageReference Include="xunit.v3.assert" Version="4.0.1" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\TSpec-agent-reference.md" Pack="true" PackagePath="\" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
