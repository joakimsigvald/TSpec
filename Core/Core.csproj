<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>A fluent Given-When-Then specification framework for xUnit. Write behavior definitions as unit tests with built-in auto-mocking and data generation</Description>
		<VersionPrefix></VersionPrefix>
		<Authors>Joakim Sigvald</Authors>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>TSpec</AssemblyName>
		<RootNamespace>TSpec</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageTags>unit test specification given when then fluent mock xunit moq automock</PackageTags>
		<PackageProjectUrl>https://github.com/joakimsigvald/TSpec</PackageProjectUrl>
		<RepositoryUrl>https://github.com/joakimsigvald/TSpec.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageVersion>2.2.0</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>
			NEW
			* Using&lt;T&gt;(setup) and Using&lt;T&gt;(transform) arrange every generated value of a type,
			  taking the same optional scope as any Using arrangement — For.Input, For.Subject or
			  For.All (default). Reads "Using Room with BedCount = 2 for Subject". Out of scope, a
			  setup neither applies nor supplies a default.

			CHANGED
			* A value arranged through an article — Given().A&lt;T&gt;(setup), .ASecond, .Two, etc. — reads
			  as the noun phrase it is: "a Room with BedCount = 2", "two Rooms with BedCount = 2".

			OBSOLETE
			* Given&lt;T&gt;(setup), Given&lt;T&gt;(transform) and the matching And overloads — use
			  Using&lt;T&gt;(...) instead. Behaviour is unchanged, and both spellings render alike.
			  Note that continuing a chain after Using reaches the Using vocabulary, so a following
			  mock setup is spelled .Given&lt;TService&gt;() rather than .And&lt;TService&gt;().
		</PackageReleaseNotes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
		<PackageReference Include="xunit.v3.assert" Version="3.2.2" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\TSpec-agent-reference.md" Pack="true" PackagePath="\" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
